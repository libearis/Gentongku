# Copy this file to `.env` (gitignored — never commit the real one) and fill
# in real local values. Read automatically by:
#   - `dotnet run` from backend/Host (via DotNetEnv, see Program.cs) for local,
#     non-Docker development — uses the ASP.NET Core double-underscore config
#     convention (`ConnectionStrings__Default` -> `ConnectionStrings:Default`).
#   - `docker-compose` natively, for `${VAR}` substitution inside
#     docker-compose.yml.

# Local (non-Docker) `dotnet run`: full connection string, host = localhost.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=gentongku;Username=postgres;Password=changeme

# Same Postgres password, used by docker-compose.yml's ${POSTGRES_PASSWORD}
# substitution (the containerized profile's connection string uses
# host.docker.internal instead of localhost, so it can't just reuse the
# ConnectionStrings__Default value above as-is).
POSTGRES_PASSWORD=changeme
